GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional: set locally if you want to force a single callback URL.
# On Netlify, leaving this unset lets the app derive the callback URL from the request host.
# AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
POST_LOGIN_REDIRECT=/
POST_LOGOUT_REDIRECT=/

NEXT_PUBLIC_API_URL=http://localhost:3000/api
